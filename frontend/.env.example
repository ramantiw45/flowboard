# Build-time configuration for the frontend.
# Copy to `.env` (git-ignored) or `.env.production` and edit. Vite only exposes
# variables prefixed with VITE_ to the bundle.
#
# Both are optional: the defaults below are what the app used before these
# existed, so a plain `npm run dev` needs no .env file at all.

# Base URL of the REST API.
VITE_API_BASE_URL=http://localhost:8080/api

# SockJS/STOMP endpoint. Optional - when unset it is derived from
# VITE_API_BASE_URL (https -> wss), so you normally only set the API URL.
# VITE_WS_URL=http://localhost:8080/ws-board
#
# The Content-Security-Policy's connect-src is generated from these two values
# (see src/config/endpoints.ts), so a custom API origin is picked up
# automatically. Remember to allow this frontend's origin in the backend's
# CORS_ALLOWED_ORIGINS as well.