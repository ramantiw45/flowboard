# Required environment for local development.
# Copy to `.env` (git-ignored) and export these before starting the backend.
# PowerShell:  Get-Content .env | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item -Path "Env:$k" -Value $v }
# bash/zsh:    set -a && . ./.env && set +a

# --- Database -------------------------------------------------------------
# Schema is owned by Flyway (src/main/resources/db/migration).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskboard
DB_USER=postgres
DB_PASS=change-me

# --- Auth -----------------------------------------------------------------
# REQUIRED. Must be at least 32 bytes for HMAC-SHA256.
# Generate a fresh value:  openssl rand -base64 48
JWT_SECRET=
# Access-token lifetime. Short on purpose: the access token lives in an HttpOnly
# cookie and is renewed silently from a refresh token, so a long-lived access
# token would only widen the window in which a stolen cookie is useful.
JWT_EXPIRATION_MS=3600000

# --- Session cookies ------------------------------------------------------
# Set AUTH_COOKIE_SECURE=true for any deployment reachable over a network; a
# cookie sent without Secure can be replayed over plain http. Left false so
# plain-http localhost development works.
AUTH_COOKIE_SECURE=false
# Lax keeps the cookie off cross-site POSTs while still allowing a shared board
# link to be opened directly.
AUTH_COOKIE_SAME_SITE=Lax
# How long a refresh token stays usable. Sign-out revokes it server-side.
AUTH_REFRESH_TTL_DAYS=7

# --- HTTP -----------------------------------------------------------------
SERVER_PORT=8080
# Comma-separated origins allowed to call the API and open the WebSocket.
# Only needed if the frontend is served from somewhere other than the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
